# --- Core ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Postgres (docker compose maps 5433 -> 5432 to avoid clashing with a local pg) ---
DATABASE_URL=postgresql://aicc:aicc@localhost:5433/aicc?schema=public

# --- Redis (docker compose maps 6380 -> 6379) ---
REDIS_URL=redis://localhost:6380

# --- Admin API auth ---
# HS256 secret used to sign and verify admin JWTs.
JWT_SECRET=dev-only-change-me-to-32-plus-random-bytes

# --- Embeddings ---
# Leave empty to run with the deterministic offline embedder (tests, offline dev).
# Asked for 1024 dimensions so the vector(1024) column and HNSW index are unchanged.
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Notifier ---
# noop | vonage | twilio
NOTIFIER=noop
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Voice webhook security ---
# vonage_jwt : Vonage AI Studio signs webhooks with a JWT carrying payload_hash.
# hmac       : generic X-Signature / X-Timestamp scheme, for local testing.
# both       : accept either (JWT preferred when an Authorization header is present).
WEBHOOK_AUTH=both
# Rejected if the signed timestamp is older/newer than this many seconds.
HMAC_TIMESTAMP_WINDOW_SECONDS=300

# --- Holds ---
HOLD_TTL_SECONDS=180

# --- Latency ---
# Vonage AI Studio Webhook nodes fail into their error branch at 5s.
# This is the hard per-endpoint ceiling the latency test asserts against.
VOICE_LATENCY_BUDGET_MS=1500
